-- Раскладка лобби-UI в логических пикселях — один источник для HUD, LobbyMenus, Tutorial и
-- макет-рендера scripts/ui_layout_preview.py (он читает этот файл и рисует PNG-схему
-- assets/store/lobby_layout.png на 1000×660, 844×390, 667×375, 1024×768, 1920×1080 и проверяет
-- пересечения, размеры под палец и что UI не закрывает путь к старту в 3D).
--
-- Масштаб корня (UI.fitScale): s = clamp(min(H / DESIGN_H, W / DESIGN_W), SCALE_MIN, 1), где W×H —
-- область ScreenGui ПОД верхней панелью Roblox (CoreUISafeInsets: топбар 58 px, вырез и
-- «полоска» телефона), а не весь ViewportSize. Логическая высота корня = H / s ≥ 565 всегда:
--   1000×660 (ПК)  → область 1000×602, s = 1,    корень 1000×602;
--   844×390 (iPhone 14, вырез 47+47, низ 21) → 750×311, s = 0.55, корень 1364×565 — худший случай;
--   667×375 (iPhone SE) → 667×317, s = 0.55, корень 1213×576;
--   Android 844×390 без выреза → 844×332, s = 0.572, корень 1474×580.
-- Раньше масштаб считался от ViewportSize/660, а верстка — от высоты 660: на телефоне реальная
-- высота корня была ~560, и низ лобби (подсказка обучения) наезжал на сундук и полоску сессии.
--
-- Запись: { anchorX, anchorY, scaleX, offsetX, scaleY, offsetY, width, height }.
-- Вертикаль лобби (корень 565…602 высотой): верх — от 0 (корень уже под топбаром Roblox: ScreenGui
-- с CoreUISafeInsets, GuiService:GetGuiInset), низ — от низа корня. Компактная раскладка (#46):
--   одна строка 2–40: монеты (слева) · «УРОВЕНЬ N» (центр) · гемы (справа) ·
--   строка мира 40–66 · полоса наград 70–128: сундук (слева) и подарок сессии (справа) — две
--     «пилюли» по 58 (≥ 32 px на телефоне; кнопки-пилюли шириной ≥ 2.5 высоты — порог MIN_PILL) ·
--   сообщения (Toasts) 134–204 — поверх всего, временно;
--   снизу: карточки −134…−6 (128: заголовок, иконка + цифра в строку, деления, цена в строку),
--     «ИГРАТЬ» −196…−138, подсказка обучения −280…−200 (на 565: 285–365 — между наградами и «ИГРАТЬ»).
-- Было (до #46): верх 6–170, низ −296…−12 — свободный центр на 565: 170…269 = 99 логических;
-- стало: 128…369 = 241 (+142 = 25% высоты корня, центр ×2.4).
-- Колонка плиток слева 64–546: 5 × (плитка 80 + подпись выступает на 10) + 4 × 8; по X 6–134
-- (подпись 128 шире плитки 80); строка валют 180–820 (на 1000) и карточки с x ≥ 240 — не
-- пересекаются. Шестерёнка справа 64–144, ракета 774–938.

local L = {}

L.DESIGN_W = 1000
L.DESIGN_H = 580
L.SCALE_MIN = 0.55

-- Пальцу и глазу (#34). На телефоне s ≈ 0.55–0.57: 44 px пальца ≈ 77 логических, 14 px текста ≈ 25.
-- Широкая кнопка-«пилюля» (ширина ≥ 2.5 высоты) — высота ≥ MIN_PILL (≈ 32 px, как сегмент iOS).
-- В окнах (UI.panel ужимается своим UIScale до ~0.5–0.6) — кнопки ≥ 48, текст ≥ 24 логических.
L.MIN_TOUCH = 77
L.MIN_PILL = 58
L.MIN_TEXT = 25
L.MIN_TOUCH_PANEL = 48
L.MIN_TEXT_PANEL = 24

-- верх: одна строка «монеты · УРОВЕНЬ N · гемы» (строка 640: пилюли 140 по краям, заголовок 300 в центре)
L.currencies = { 0.5, 0, 0.5, 0, 0, 2, 640, 38 }
L.CURRENCY_W = 140 -- ширина пилюли валюты (монеты — левый край строки, гемы — правый)
L.levelTitle = { 0.5, 0, 0.5, 0, 0, 2, 300, 38 }
L.worldLine = { 0.5, 0, 0.5, 0, 0, 40, 500, 26 }
-- полоса наград: сундук 250 + 12 + подарок сессии 280 = 542, по центру
L.chest = { 0.5, 0, 0.5, -146, 0, 70, 250, 58 }
L.session = { 0.5, 0, 0.5, 131, 0, 70, 280, 58 }
-- сообщения («Не хватает монет», «ЗАДАНИЕ ВЫПОЛНЕНО!») — свой ScreenGui выше окон
L.toastLobby = { 0.5, 0, 0.5, 0, 0, 134, 460, 70 } -- до двух строк по 27
-- Тексты заезда — внизу по центру, под санями (владелец 2026-11-12: «закрывают обзор во время
-- движения»): всплывашка трюка/удара −8…−66, баннер зоны −72…−128, сообщение −134…−194. Между
-- спидометром (слева) и ракетой (справа); трасса впереди и горизонт — свободны.
L.runToast = { 0.5, 1, 0.5, 0, 1, -8, 520, 58 }
L.toastRun = { 0.5, 1, 0.5, 0, 1, -134, 460, 60 }

-- низ
L.cards = { 0.5, 1, 0.5, 0, 1, -6, 520, 128 } -- 3 × 164 + 2 × 14 (заголовок «РОГАТКА» кеглем ≥ 25)
L.card = { 0, 0, 0, 0, 0, 0, 164, 128 }
-- внутри карточки 164×128 (сверху вниз): заголовок 2–28 · иконка 42 + цифра эффекта в одну строку
-- 30–72 · деления тира 76–88 · цена в одну строку 92–122 (кегль 26). Вся карточка — зона нажатия.
L.CARD_TITLE_H = 26
L.CARD_ART_Y = 30
L.CARD_ART_H = 42
L.CARD_PIP_Y = 76
L.CARD_PIP_H = 12
L.CARD_BTN_H = 30
L.rocket = { 0, 1, 0.5, 274, 1, -6, 164, 128 } -- без делений (#47): «ракета → следующая» и цена
L.ROCKET_ART_H = 58 -- у ракеты картинка 30–88 (места делений нет): «текущая ▶ следующая» + топливо «2.1→3.6с»
L.play = { 0.5, 1, 0.5, 0, 1, -138, 520, 58 }
L.tutorialLobby = { 0.5, 1, 0.5, 0, 1, -200, 720, 80 }
L.tutorialRun = { 0.5, 0, 0.5, 0, 0, 132, 720, 80 }
L.tutorialLaunch = { 0.5, 0, 0.5, 0, 0, 196, 720, 80 }
L.TUTORIAL_SKIP_W = 190 -- «ПРОПУСТИТЬ» кеглем ≥ 25
-- Заезд (#71): баннер зоны «Ледяная пещера!» — внизу по центру над всплывашкой трюка (см. runToast).
L.zoneBanner = { 0.5, 1, 0.5, 0, 1, -72, 600, 56 }
-- Телефон (сенсор без клавиатуры, UI.isPhone; владелец 2026-11-12): метры — в полосу топбара Roblox
-- (client/HUD), баннер зоны 4–46 и сообщение 50–104 — вверху; рекорд, комбо и всплывашка трюка — внизу
-- по центру: трюк −8…−54, рекорд −58…−82, комбо −86…−114 (между спидометром слева и кнопкой
-- трюка Roblox справа: она на −230 px от правого края ≈ 946+ логических на корне 1364).
L.bestPhone = { 0.5, 1, 0.5, 0, 1, -58, 240, 24 }
L.comboPhone = { 0.5, 1, 0.5, 0, 1, -86, 300, 28 }
L.runToastPhone = { 0.5, 1, 0.5, 0, 1, -8, 480, 46 }
L.zoneBannerPhone = { 0.5, 0, 0.5, 0, 0, 4, 600, 42 }
L.toastRunPhone = { 0.5, 0, 0.5, 0, 0, 50, 460, 54 }

-- колонки
L.tiles = { 0, 0, 0, 30, 0, 64, 80, 80 } -- первая плитка; следующие ниже на TILE_STEP
L.TILE_STEP = 98 -- 80 + 10 (подпись выступает) + 8
L.tileLabel = { 0.5, 0, 0.5, 0, 1, -20, 128, 30 } -- внутри плитки: на 20 заходит, на 10 выступает
L.tileBadge = { 0.5, 0.5, 1, -4, 0, 18, 34, 34 } -- бейдж в правом верхнем углу (центр), не выше плитки
L.gear = { 1, 0, 1, -18, 0, 64, 84, 80 }

return L
